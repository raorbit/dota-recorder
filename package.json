{
  "name": "dota-recorder",
  "version": "0.1.16",
  "private": true,
  "description": "Dota 2 Recorder - personal desktop app that auto-records matches, tags moments, and browses VODs.",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "npm --prefix app run dev",
    "dev:electron": "npm --prefix app run build:electron && cross-env NODE_ENV=development DOTAREC_DEV=1 electron app",
    "build:app": "npm --prefix app run build",
    "build:electron": "npm --prefix app run build:electron",
    "build:core": "node scripts/build-core.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm --prefix app run typecheck",
    "build:all": "npm run fetch:hero-icons && npm run build:core && npm run build:app && npm run build:electron",
    "fetch:obs": "node scripts/fetch-obs.mjs",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "fetch:hero-icons": "node scripts/fetch-hero-icons.mjs",
    "gsi:replay": "node scripts/gsi-replay.mjs",
    "dist": "npm run fetch:obs && npm run fetch:ffmpeg && npm run build:all && electron-builder --win nsis --x64 --publish never",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "prettier": "^3.9.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.63.0"
  }
}
