# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/

# Build output
dist/
build/
out/
.next/
.nuxt/
.cache/
.vite/

# Environment / secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Java / Gradle
.gradle/

# App packaging output
app/electron-dist/
release/

# Bundled OBS — fetched + extracted at build time by scripts/fetch-obs.mjs.
# Not tracked (multi-hundred-MB binaries); CI/build regenerates it from the pinned
# version + sha256. Leaves the rest of build-resources/ trackable (icons, etc.).
build-resources/obs/

# Bundled ffmpeg — fetched + extracted at build time by scripts/fetch-ffmpeg.mjs
# (same rationale as OBS above): the ~100MB exe + its version marker regenerate from
# the pinned sha256, so neither is tracked.
build-resources/ffmpeg/
build-resources/.ffmpeg-*.ok

# Bundled hero portraits — fetched at build time by scripts/fetch-hero-icons.mjs from Valve's
# CDN (hero list via OpenDota). ~7 MB of PNGs + a version marker regenerate from the slug list,
# so they stay untracked; the tracked .gitkeep keeps the dir present so Vite's import.meta.glob
# always resolves. Delete the marker (or bump HERO_ICONS_VERSION) to refresh when Valve adds a hero.
app/src/data/hero-portraits/*.png
app/src/data/hero-portraits/*.tmp
app/src/data/hero-portraits/.hero-icons-*.ok

# Local SQLite db + write-ahead files / migration backups
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite.*.bak

# Test / coverage
coverage/
.nyc_output/

# Editor / IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
Desktop.ini
